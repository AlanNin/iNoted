{
  "name": "inoted",
  "version": "1.1.6",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean:eas:dev:build": "npx drizzle-kit generate && npx expo prebuild -p android --clean && eas build --profile development --platform android",
    "eas:dev:build": "eas build --profile development --platform android",
    "clean:eas:prod:build": "npx drizzle-kit generate && npx expo prebuild -p android --clean && eas build --platform android",
    "eas:prod:build": "eas build --platform android",
    "clean:local:dev:build": "npx drizzle-kit generate && npx expo prebuild -p android --clean && npx expo run:android",
    "clean:local:prod:build": "npx drizzle-kit generate && npx expo prebuild -p android --clean && npx expo run:android --variant release",
    "local:dev:build": "npx expo run:android",
    "local:prod:build": "npx expo run:android --variant release"
  },
  "dependencies": {
    "@backpackapp-io/react-native-toast": "^0.13.0",
    "@dev-plugins/react-query": "~0.4.0",
    "@expo/dom-webview": "~57.0.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@lexical/react": "^0.48.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/blur": "^4.4.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.62.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.36.4",
    "expo": "^57.0.8",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.7",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-document-picker": "~57.0.1",
    "expo-drizzle-studio-plugin": "^0.2.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.8",
    "expo-sharing": "~57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "lexical": "^0.48.0",
    "lodash": "^4.17.21",
    "lucide-react-native": "^0.545.0",
    "moti": "^0.29.0",
    "motion": "^11.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-actions-sheet": "^0.9.7",
    "react-native-calendars": "^1.1313.0",
    "react-native-collapsible": "^1.6.2",
    "react-native-device-info": "^14.0.2",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-navigation-bar-detector": "^0.1.4",
    "react-native-reanimated": "4.5.0",
    "react-native-reanimated-carousel": "^3.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.0",
    "react-native-toast-message": "^2.2.1",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "reanimated-color-picker": "~4.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@tanstack/eslint-plugin-query": "^5.61.6",
    "@types/lodash": "^4.17.13",
    "@types/react": "~19.2.10",
    "babel-plugin-inline-import": "^3.0.0",
    "baseline-browser-mapping": "^2.9.11",
    "drizzle-kit": "^0.28.1",
    "patch-package": "^8.0.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "android": {
      "userInterfaceStyle": "automatic"
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "lucide-react-native",
          "drizzle-orm",
          "expo-drizzle-studio-plugin",
          "@dev-plugins/react-query",
          "@backpackapp-io/react-native-toast",
          "date-fns",
          "date-fns-tz",
          "react-native-keyboard-aware-scroll-view",
          "@lexical/react",
          "lexical",
          "motion",
          "react-native-navigation-bar-detector"
        ]
      }
    }
  }
}
